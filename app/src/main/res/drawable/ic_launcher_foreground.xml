<?xml version="1.0" encoding="utf-8"?>
<!-- Premier plan de l'icône adaptative, adapté de la maquette SVG (micro + ondes).
Sans l'ombre portée (non supportée par VectorDrawable, le lanceur gère l'élévation)
et sans le liseré blanc à 8 % (invisible à taille d'icône). -->
<vector xmlns:android="http://schemas.android.com/apk/res/android"
    android:width="108dp"
    android:height="108dp"
    android:viewportWidth="108"
    android:viewportHeight="108">

    <!-- Onde extérieure -->
    <path
        android:pathData="M25.31,35.86 A35.86,35.86 0 0 1 82.69,35.86"
        android:strokeWidth="2.74"
        android:strokeColor="#FF8A65"
        android:strokeLineCap="round"
        android:fillColor="#00000000" />

    <!-- Onde intérieure -->
    <path
        android:pathData="M33.75,43.24 A25.31,25.31 0 0 1 74.25,43.24"
        android:strokeWidth="2.32"
        android:strokeColor="#FF7043"
        android:strokeAlpha="0.8"
        android:strokeLineCap="round"
        android:fillColor="#00000000" />

    <!-- Capsule du micro -->
    <path
        android:pathData="M45.56,45.14 L45.56,52.31 A8.44,8.44 0 0 0 62.44,52.31 L62.44,45.14 A8.44,8.44 0 0 0 45.56,45.14 Z"
        android:strokeWidth="2.53"
        android:strokeColor="#FFFFFF"
        android:strokeAlpha="0.95"
        android:strokeLineCap="round"
        android:fillColor="#00000000" />

    <!-- Fente acoustique -->
    <path
        android:pathData="M48.09,48.73 L59.9,48.73"
        android:strokeWidth="1.69"
        android:strokeColor="#FFFFFF"
        android:strokeAlpha="0.6"
        android:strokeLineCap="round"
        android:fillColor="#00000000" />

    <!-- Berceau (arche en U) -->
    <path
        android:pathData="M36.7,51.05 C36.7,68.34 71.29,68.34 71.29,51.05"
        android:strokeWidth="2.74"
        android:strokeColor="#FFFFFF"
        android:strokeAlpha="0.95"
        android:strokeLineCap="round"
        android:fillColor="#00000000" />

    <!-- Pied -->
    <path
        android:pathData="M54,68.34 L54,80.16"
        android:strokeWidth="2.74"
        android:strokeColor="#FFFFFF"
        android:strokeAlpha="0.95"
        android:strokeLineCap="round"
        android:fillColor="#00000000" />

    <!-- Base -->
    <path
        android:pathData="M43.45,80.16 L64.55,80.16"
        android:strokeWidth="2.74"
        android:strokeColor="#FFFFFF"
        android:strokeAlpha="0.95"
        android:strokeLineCap="round"
        android:fillColor="#00000000" />
</vector>
