<?xml version="1.0" encoding="utf-8"?>
<!-- Sauvegarde auto (Android 6 à 11) : base Room + réglages DataStore.
     Fichiers d'épisodes exclus : re-téléchargeables, trop volumineux. -->
<full-backup-content>
    <include domain="database" path="acrovox.db" />
    <include domain="file" path="datastore/" />
    <exclude domain="file" path="podcasts/" />
</full-backup-content>
