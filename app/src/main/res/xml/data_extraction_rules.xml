<?xml version="1.0" encoding="utf-8"?>
<!-- Sauvegarde auto (Android 12+) : cloud et transfert d'appareil.
     Même périmètre que backup_rules.xml. Le mot de passe de synchro,
     chiffré par le keystore de l'appareil d'origine, n'est pas
     transférable : à ressaisir après restauration sur un autre appareil. -->
<data-extraction-rules>
    <cloud-backup>
        <include domain="database" path="acrovox.db" />
        <include domain="file" path="datastore/" />
    </cloud-backup>
    <device-transfer>
        <include domain="database" path="acrovox.db" />
        <include domain="file" path="datastore/" />
    </device-transfer>
</data-extraction-rules>
